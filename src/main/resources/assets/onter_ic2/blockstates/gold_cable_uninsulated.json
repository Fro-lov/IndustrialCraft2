      },
      "apply": {
        "model": "onter_ic2:block/gold_cable_uninsulated_side",
        "y": 270
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "onter_ic2:block/gold_cable_uninsulated_side",
        "y": 90
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "onter_ic2:block/gold_cable_uninsulated_side",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "onter_ic2:block/gold_cable_uninsulated_side",
        "x": 90
